<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!--
        neverForLocation: we BLE-scan (filtered on the controller's service UUID)
        only to find/reconnect the vehicle. We never derive physical location from
        scan results, so the system can skip the location-services requirement on
        Android 12+.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- Precise location: BT discovery on Android 11 and below, and the live map /
         turn-by-turn navigation on every version (coarse ~2 km is unusable there). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Call mirroring: incoming/ongoing calls don't arrive through the
         NotificationListenerService, so CallStateRelay listens to telephony call
         state and pushes category=1 frames to the board (NOTIFICATION-APP-FIXME.md §3). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Call control: the cluster's Answer/End buttons (0xAF05 uplink) act on the
         phone call via TelecomManager (docs/CALL-CONTROL-INTEGRATION.md). -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Doze can kill the bound notification listener; Settings offers the user a
         one-tap exemption so relaying survives the screen being off on the bike. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- MapLibre tile fetch + GraphHopper Directions API. Previously supplied
         transitively by the Google Maps SDK; declared explicitly now. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- BLE transport (GATT). The controller is a BLE peripheral; the app is the
         central. Required — the app talks to the vehicle exclusively over BLE. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:name=".DisplayApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DisplayApp">

        <!-- MapLibre needs no manifest API key. The tile style URL comes from
             local.properties (MAP_STYLE_URL) via BuildConfig; a missing/empty
             style is handled at runtime by the MapStyleGate placeholder. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.DisplayApp.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TelemetryService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
            Notification relay: mirrors the phone's status-bar notifications to the
            board's on-screen banner (docs/APP-NOTIFICATION-INTEGRATION.md). Bound by
            the system, so it must be exported and gated by the system-held
            BIND_NOTIFICATION_LISTENER_SERVICE permission. The user must grant
            "Notification access" in system settings AND enable the in-app toggle
            (Settings → Phone notifications) before anything is relayed.
        -->
        <service
            android:name=".service.NotificationRelayService"
            android:exported="true"
            android:label="Vehicle display notification relay"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            FileProvider for sharing exported trip CSVs via ACTION_SEND.
            Authority must be globally unique — we use the app id with a `.fileprovider` suffix.
            See res/xml/file_paths.xml for the exposed directories.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
